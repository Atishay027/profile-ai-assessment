# Backend environment (copy to backend/.env — do NOT commit the real .env)

APP_ENV=development

# SQLite (default). File persists across restarts.
DATABASE_URL=sqlite:///./app.db

# Google Gemini — key stays server-side only, never shipped to the mobile app.
GEMINI_API_KEY=your_gemini_api_key_here
# Configurable model name; set to one your key supports, e.g. gemini-2.0-flash or gemini-1.5-flash
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=20

# CORS: comma-separated origins. Permissive for local dev; restrict in production.
CORS_ORIGINS=*

# Fixed demo user for this assessment
DEMO_USER_ID=user-001
